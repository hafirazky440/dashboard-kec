APP_NAME="Cicalengka Dalam Angka"
APP_ENV=testing
APP_KEY=base64:aZUa4X61AFxT2Wv4D31D3DfJuT7T+r8SRBJzohNlMaE=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Test memakai database terpisah agar data di database utama tidak
# pernah terhapus oleh RefreshDatabase. Driver-nya sama dengan .env,
# yaitu mariadb.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cicalengka_dalam_angka_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array

# Panel admin memakai cookie sesi juga saat testing.
BCRYPT_ROUNDS=4
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false